# Firebase project config — ambil dari Firebase Console > Project Settings > General > Your apps (Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=

# PENTING: isi ini dengan domain Hosting kamu (mis. <project-id>.web.app), BUKAN
# nilai <project-id>.firebaseapp.com yang dikasih Firebase Console. Login Google
# butuh authDomain satu origin dengan app-nya — kalau beda origin, browser yang
# blokir cookie pihak ketiga bakal bikin login gagal dengan error menyesatkan
# "auth/api-key-not-valid" walaupun API key-nya sebenarnya benar.
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Daftar email yang boleh login, dipisah koma (lihat src/lib/auth-context.tsx).
# PENTING: menambah/mencabut email di sini TIDAK cukup — firestore.rules punya
# daftar yang sama secara literal (rules Firestore gak bisa baca env var) dan
# harus diedit manual juga, lalu deploy ulang: firebase deploy --only firestore:rules
NEXT_PUBLIC_ALLOWED_EMAILS=aljihadjundy@gmail.com,mayakris402@gmail.com

# Buat push notification (reminder). Ambil dari Firebase Console >
# Project Settings > Cloud Messaging > Web configuration > Generate key pair
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Opsional — statistik channel YouTube di modul Branding.
# Google Cloud Console > APIs & Services: aktifkan "YouTube Data API v3",
# lalu buat API key. WAJIB dibatasi: Application restrictions = HTTP referrers
# (isi domain Hosting kamu), API restrictions = YouTube Data API v3 saja.
# Key ini ikut terkirim ke browser, jadi pembatasan itu yang melindunginya.
NEXT_PUBLIC_YOUTUBE_API_KEY=
