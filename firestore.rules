rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * Email yang boleh masuk.
     *
     * HARUS disinkronkan manual dengan NEXT_PUBLIC_ALLOWED_EMAILS di
     * .env.local (lihat src/lib/firebase.ts) — rules Firestore tidak bisa
     * membaca env var, jadi daftar ini ditulis literal di sini.
     *
     * Tanpa pemeriksaan ini, gerbang di auth-context.tsx hanya berlaku di UI:
     * siapa pun yang punya akun Google bisa memanggil Firestore SDK langsung
     * (lewat konsol browser atau app lain) dan membaca/menulis di bawah uid
     * mereka sendiri, karena rule sebelumnya hanya memeriksa apakah uid di
     * path cocok dengan uid yang login — bukan siapa pemilik uid itu.
     */
    function isAllowed() {
      return request.auth != null &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() in [
          "aljihadjundy@gmail.com",
          "mayakris402@gmail.com"
        ];
    }

    // Setiap dokumen hidup di users/{uid}/... dan hanya pemilik uid itu — yang
    // emailnya ada di isAllowed() — yang boleh membaca/menulisnya.
    match /users/{uid}/{document=**} {
      allow read, write: if isAllowed() && request.auth.uid == uid;
    }

    /**
     * Form waitlist di landing page — pengunjung yang belum login sama sekali
     * (belum ada akun Google, apalagi email di isAllowed()) harus bisa nulis
     * ke sini. Create-only dan tervalidasi ketat di server, supaya collection
     * ini tidak bisa dipakai jadi celah baca/tulis data lain: tidak ada read,
     * update, atau delete dari client sama sekali — cuma developer yang bisa
     * melihat daftarnya, lewat Firebase Console atau Admin SDK.
     */
    match /waitlist/{id} {
      allow create: if request.resource.data.keys().hasOnly(["email", "name", "useCase", "createdAt"])
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() <= 200
        && request.resource.data.email.matches("^[^@\\s]+@[^@\\s]+[.][^@\\s]+$")
        && (!("name" in request.resource.data) ||
          (request.resource.data.name is string && request.resource.data.name.size() <= 100))
        && (!("useCase" in request.resource.data) ||
          (request.resource.data.useCase is string && request.resource.data.useCase.size() <= 500))
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }
  }
}
